{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p gateway-dist",
  "outputDirectory": "gateway-dist",
  "functions": { "api/index.ts": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?route=:path*" }
  ]
}
