# Server only. Never prefix these with VITE_. Configure through Vercel environment settings.
DATABASE_URL=
AD_SERVICE_ROLE=app
APP_ORIGIN=
GATEWAY_ORIGIN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Exact verified Grok OAuth callback URL(s), comma separated. No guessed or wildcard callbacks.
SCOUT_REDIRECT_URIS=
# X OAuth, server only. Reuse the owner's existing developer app; no likes or write scope.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# 32 random bytes encoded as base64. Never rotate while connections are active.
AD_TOKEN_ENCRYPTION_KEY=
# Explicit opt-in; no provider calls unless enabled, keyed and a model is configured.
AD_AI_ENABLED=0
AD_AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
# Google OIDC: link from a verified GitHub owner session before Google login.
# Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Instagram Login (professional Creator/Business only). No saved-post read scope exists.
# Callback: APP_ORIGIN/api/instagram/callback
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
# Operator-only connection maintenance. Generated/provisioned without end-user configuration.
AD_AUTOMATION_SECRET=
# Dedicated gateway only; fixed-job relay credentials, not application user credentials.
AD_JOB_RELAY_SECRET=
AD_JOB_RELAY_BYPASS=

# Operator approval for existing X API credits. Disabled unless explicitly authorized.
X_BOOKMARK_IMPORT_ALLOWED=0

# Public Studio lead capture. Set AFTER legitimate company identity/privacy notice.
# Server switch defaults to OFF, no request is stored until all gates are configured.
AD_PUBLIC_ENQUIRIES_ENABLED=0
AD_TURNSTILE_SECRET_KEY=
AD_PRIVACY_NOTICE_URL=
AD_BUSINESS_LEGAL_NAME=
# Verified entrepreneur individuel form and 14-digit SIRET. Do not invent either.
AD_BUSINESS_LEGAL_FORM=EI
AD_BUSINESS_SIRET=
# TVA regime is a separate decision, never inferred from the EI form.
# Configure invoices only after verifying it: FRANCHISE / REAL / OTHER.
AD_BUSINESS_VAT_REGIME=UNCONFIRMED
# Vite public: Turnstile site key only, never secret.
VITE_AD_STUDIO_TURNSTILE_SITE_KEY=
# Fallback professional inbox for visitors when public capture is not active.
VITE_AD_STUDIO_CONTACT_EMAIL=

# V3 private cloud workspace backup: OFF until additive migration and QA verified.
AD_WORKSPACE_SYNC_ENABLED=0
VITE_AD_WORKSPACE_SYNC_UI=0
