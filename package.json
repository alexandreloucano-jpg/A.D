{
  "name": "ad-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "preview:export": "npm run build && node scripts/export-preview.mjs",
    "db:migrate": "node scripts/migrate-server.mjs",
    "db:migrate:reader:beta": "node scripts/migrate-reader-beta.mjs"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.11",
    "@neondatabase/serverless": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  }
}
